    lines += [("TEMP. ⊥", f"Ø {r['v_temp']['n']} @ {r['s_temp']:.0f} cm")]

    y = 0.97
    for lbl, val in lines:
        if lbl == "":
            y -= 0.04; continue
        bold = lbl in ("ACERO (+)","ACERO (−)","TEMP. ⊥")
        color = AZUL if lbl=="ACERO (+)" else ROJO if lbl=="ACERO (−)" else VERDE if "TEMP" in lbl else "#1E293B"
        ax5.text(0.02, y, lbl, transform=ax5.transAxes,
                 fontsize=8, color=color, fontweight="bold" if bold else "normal")
        ax5.text(0.98, y, val, transform=ax5.transAxes,
                 fontsize=8, color="#374151", ha="right")
        ax5.plot([0.02, 0.98], [y-0.01, y-0.01],
                 transform=ax5.transAxes, color=BORDE, lw=0.5, clip_on=False)
        y -= 0.063

    buf = io.BytesIO()
    fig.savefig(buf, format="png", dpi=130, bbox_inches="tight", facecolor=FONDO)
    plt.close(fig)
    buf.seek(0)
    return base64.b64encode(buf.read()).decode()

