  .card{background:#fff;border-radius:12px;border:1px solid #E2E8F0;padding:16px;margin-bottom:16px}
  .card-title{font-size:13px;font-weight:600;color:#1E293B;margin-bottom:12px;
    padding-bottom:8px;border-bottom:1px solid #F1F5F9}
  .metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px;margin-bottom:16px}
  .metric{background:#F8FAFC;border-radius:8px;padding:10px 12px;border:1px solid #E2E8F0}
  .metric .lbl{font-size:10px;color:#64748B;margin-bottom:3px;font-weight:500}
  .metric .val{font-size:19px;font-weight:700;color:#1E293B}
  .metric .unit{font-size:10px;color:#94A3B8}
  .img-wrap{text-align:center}
  .img-wrap img{max-width:100%;border-radius:10px;border:1px solid #E2E8F0;box-shadow:0 2px 8px rgba(0,0,0,.07)}
  .spinner{display:none;text-align:center;padding:60px;color:#64748B;font-size:14px}
  .spinner.show{display:block}
  .spin{display:inline-block;width:28px;height:28px;border:3px solid #E2E8F0;
    border-top-color:#2563EB;border-radius:50%;animation:spin .7s linear infinite;margin-bottom:10px}
  @keyframes spin{to{transform:rotate(360deg)}}
  .empty{text-align:center;padding:80px 20px;color:#94A3B8}
  .empty svg{width:48px;height:48px;margin-bottom:12px;opacity:.4}
  .info{background:#EFF6FF;border:1px solid #BFDBFE;border-radius:8px;padding:10px 12px;
    font-size:12px;color:#1E40AF;margin-bottom:14px;line-height:1.5}
  .tip{font-size:11px;color:#94A3B8;margin-top:4px}
  .tag-min{background:#FEF9C3;color:#854D0E;font-size:10px;padding:1px 6px;border-radius:4px;font-weight:600}
  .tag-ok {background:#DCFCE7;color:#166534;font-size:10px;padding:1px 6px;border-radius:4px;font-weight:600}
</style>
</head>
<body>
<header>
  <div>
    <h1>Diseño de Losa Maciza en Una Dirección</h1>
    <p>Norma E.060 / ACI 318 — Universidad Continental</p>
  </div>
  <span class="badge">Concreto Armado I</span>
</header>

<div class="layout">
<!-- ═══ SIDEBAR ═══ -->
<aside class="sidebar">

  <div class="section">
    <div class="section-title">Geometría</div>
    <div class="grid2">
      <div class="field">
        <label>Luz libre L₁ (m)</label>
        <input type="number" id="L1" value="4.70" step="0.05" min="1" max="20">
      </div>
      <div class="field">
        <label>Luz libre L₂ (m)</label>
        <input type="number" id="L2" value="5.20" step="0.05" min="0" max="20">
        <span class="tip">0 si no hay tramo central</span>
      </div>
      <div class="field">
        <label>Luz libre L₃ (m)</label>
        <input type="number" id="L3" value="4.50" step="0.05" min="0" max="20">
      </div>
    </div>
    <div class="field">
      <label>Número de tramos</label>
      <select id="ntramos">
        <option value="1">1 tramo</option>
        <option value="2">2 tramos</option>
        <option value="3" selected>3 tramos</option>
      </select>
    </div>
    <div class="field">
      <label>Tipo de apoyo (para h mín)</label>
      <select id="tipo_borde">
        <option value="0">Simplemente apoyado (L/20)</option>
        <option value="1" selected>Un extremo continuo (L/24)</option>
        <option value="2">Ambos extremos continuos (L/28)</option>
        <option value="3">En voladizo (L/10)</option>
      </select>
    </div>
  </div>

  <div class="section">
    <div class="section-title">Materiales</div>
    <div class="grid3">
      <div class="field">
        <label>f'c (kg/cm²)</label>
        <select id="fc">
          <option value="175">175</option>
          <option value="210" selected>210</option>
          <option value="280">280</option>
          <option value="350">350</option>
        </select>
      </div>
      <div class="field">
        <label>fy (kg/cm²)</label>
        <select id="fy">
          <option value="2800">2800</option>
          <option value="4200" selected>4200</option>
        </select>
      </div>
    </div>
    <div class="grid3">
      <div class="field">
        <label>Recubrimiento (cm)</label>
        <input type="number" id="recub" value="2.0" step="0.5" min="1.5" max="5">
      </div>
      <div class="field">
        <label>Ø varilla (cm)</label>
        <select id="diam_v">
          <option value="0.953">3/8" (0.953)</option>
          <option value="1.270" selected>1/2" (1.270)</option>
          <option value="1.588">5/8" (1.588)</option>
          <option value="1.905">3/4" (1.905)</option>
        </select>
      </div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">Cargas muertas (kg/m²)</div>
    <div class="grid3">
      <div class="field">
        <label>Acabados</label>
        <input type="number" id="acabados" value="150" step="10" min="0">
      </div>
      <div class="field">
        <label>Tabiquería</label>
        <input type="number" id="tabiqueria" value="100" step="10" min="0">
      </div>
    </div>
    <div class="field">
      <label>Adicional CM</label>
      <input type="number" id="cm_extra" value="0" step="10" min="0">
    </div>
  </div>

  <div class="section">
    <div class="section-title">Carga viva (kg/m²)</div>
    <div class="grid2">
      <div class="field">
        <label>Sobrecarga S/C</label>
        <input type="number" id="sc" value="300" step="50" min="0">
      </div>
      <div class="field">
        <label>Adicional CV</label>
        <input type="number" id="cv_extra" value="0" step="10" min="0">
      </div>
    </div>
  </div>

  <div class="info">
    Wu = <strong>1.4 CM + 1.7 CV</strong> &nbsp;|&nbsp; ρ mín = 0.0018 (fy≥420 MPa)
  </div>

  <button class="btn" onclick="disenar()" id="btn-calc">⚙ Calcular diseño</button>

</aside>

<!-- ═══ MAIN ═══ -->
<main class="main">

  <div class="spinner" id="spinner">
    <div class="spin"></div>
    <p>Calculando y generando gráfico...</p>
  </div>

  <div id="resultado" style="display:none">
    <div class="metrics" id="metrics"></div>
    <div class="card">
      <div class="card-title">Selección de acero de refuerzo</div>
      <div id="tabla-acero"></div>
    </div>
    <div class="card">
      <div class="card-title">Plano de diseño</div>
      <div class="img-wrap"><img id="grafico" src="" alt="Gráfico de diseño"></div>
    </div>
  </div>

  <div class="empty" id="empty">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
        d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 11h.01M12 11h.01M15 11h.01M4 19h16a2 2 0 002-2V7a2 2 0 00-2-2H4a2 2 0 00-2 2v10a2 2 0 002 2z"/>
    </svg>
    <p style="font-size:14px;font-weight:600;color:#475569">Ingresa los datos y presiona Calcular</p>
    <p style="font-size:12px;margin-top:4px">Los resultados y el plano gráfico aparecerán aquí</p>
  </div>

</main>
</div>

<script>
async function disenar(){
  const btn = document.getElementById('btn-calc');
  btn.disabled = true;
  document.getElementById('spinner').classList.add('show');
  document.getElementById('resultado').style.display='none';
  document.getElementById('empty').style.display='none';

  const payload = {
    L1: +document.getElementById('L1').value,
    L2: +document.getElementById('L2').value,
    L3: +document.getElementById('L3').value,
    ntramos: +document.getElementById('ntramos').value,
    tipo_borde: +document.getElementById('tipo_borde').value,
    fc: +document.getElementById('fc').value,
    fy: +document.getElementById('fy').value,
    recub: +document.getElementById('recub').value,
    diam_v: +document.getElementById('diam_v').value,
    acabados: +document.getElementById('acabados').value,
    tabiqueria: +document.getElementById('tabiqueria').value,
    cm_extra: +document.getElementById('cm_extra').value,
    sc: +document.getElementById('sc').value,
    cv_extra: +document.getElementById('cv_extra').value,
  };

  const resp = await fetch('/calcular', {
    method:'POST',
    headers:{'Content-Type':'application/json'},
    body: JSON.stringify(payload)
  });
  const data = await resp.json();

  document.getElementById('spinner').classList.remove('show');
  btn.disabled = false;

  if(data.error){ alert('Error: '+data.error); document.getElementById('empty').style.display='block'; return; }

  // Métricas
  const r = data.resultado;
  const metrics = [
    {lbl:"h adoptado", val: (r.h*100).toFixed(0), unit:"cm"},
    {lbl:"d efectivo", val: r.d.toFixed(1), unit:"cm"},
    {lbl:"Wu",         val: r.Wu.toFixed(4), unit:"tonf/m"},
    {lbl:"CM total",   val: r.CM.toFixed(0), unit:"kg/m²"},
    {lbl:"CV total",   val: r.CV.toFixed(0), unit:"kg/m²"},
    {lbl:"As mínimo",  val: r.As_min.toFixed(2), unit:"cm²"},
    {lbl:"ρ mín",      val: r.rho_min, unit:""},
    {lbl:"Temp. ⊥",   val:"Ø "+r.v_temp.n+" @"+r.s_temp+" cm", unit:""},
  ];
  document.getElementById('metrics').innerHTML = metrics.map(m=>
    `<div class="metric"><div class="lbl">${m.lbl}</div>
     <div class="val">${m.val}<span class="unit"> ${m.unit}</span></div></div>`
  ).join('');

  // Tabla de acero
  const cols = ["Sección","Mu (t·m)","As calc","As mín","As final","Varilla","S (cm)","As prov","Estado"];
  let html = `<table style="width:100%;border-collapse:collapse;font-size:12.5px">
    <thead><tr style="background:#1E3A5F;color:#fff">${cols.map(c=>`<th style="padding:7px 10px;text-align:center;font-weight:600">${c}</th>`).join('')}</tr></thead>
    <tbody>`;
  r.resultados.forEach((row,i)=>{
    const bg = i%2===0?'#F8FAFC':'#fff';
    const est = row.usa_min
      ? '<span class="tag-min">ρ mín ▲</span>'
      : '<span class="tag-ok">calc. ✓</span>';
    html += `<tr style="background:${bg}">
      <td style="padding:6px 10px;font-weight:600">${row.label}</td>
      <td style="padding:6px 10px;text-align:center">${row.Mu.toFixed(4)}</td>
      <td style="padding:6px 10px;text-align:center">${row.As_calc.toFixed(2)}</td>
      <td style="padding:6px 10px;text-align:center">${row.As_min.toFixed(2)}</td>
      <td style="padding:6px 10px;text-align:center;font-weight:700">${row.As_final.toFixed(2)}</td>
      <td style="padding:6px 10px;text-align:center">Ø ${row.varilla.n}</td>
      <td style="padding:6px 10px;text-align:center">${row.s}</td>
      <td style="padding:6px 10px;text-align:center">${row.As_prov.toFixed(2)}</td>
      <td style="padding:6px 10px;text-align:center">${est}</td>
    </tr>`;
  });
  html += '</tbody></table>';
  document.getElementById('tabla-acero').innerHTML = html;

  // Gráfico
  document.getElementById('grafico').src = 'data:image/png;base64,'+data.imagen;
  document.getElementById('resultado').style.display='block';
}
</script>
</body>
</html>"""

# ──────────────────────────────────────────────
# SERVIDOR HTTP
# ──────────────────────────────────────────────
class Handler(BaseHTTPRequestHandler):
    def log_message(self, *_): pass   # silenciar logs

    def do_GET(self):
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.end_headers()
        self.wfile.write(HTML.encode())

    def do_POST(self):
        length = int(self.headers["Content-Length"])
        body   = self.rfile.read(length)
        try:
            p   = json.loads(body)
            r   = disenar(p)
            img = generar_grafico(p, r)
            # Serializar varillas
            for rr in r["resultados"]:
                rr["varilla"] = {"n": rr["varilla"]["n"], "A": rr["varilla"]["A"]}
            r["v_temp"] = {"n": r["v_temp"]["n"]}
            payload = json.dumps({"resultado": r, "imagen": img})
        except Exception as e:
            payload = json.dumps({"error": str(e)})

        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(payload.encode())

# ──────────────────────────────────────────────
# MAIN
# ──────────────────────────────────────────────
if __name__ == "__main__":
    PORT = 8765
    server = HTTPServer(("", PORT), Handler)
    print("=" * 58)
    print("  DISEÑO DE LOSA MACIZA — App interactiva")
    print(f"  Abriendo en:  http://localhost:{PORT}")
    print("  Presiona  Ctrl+C  para salir")
    print("=" * 58)
    threading.Timer(1.2, lambda: webbrowser.open(f"http://localhost:{PORT}")).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n  Servidor detenido.")
