VARILLAS = [
    {"n": '3/8"',  "d": 0.953, "A": 0.71},
    {"n": '1/2"',  "d": 1.270, "A": 1.27},
    {"n": '5/8"',  "d": 1.588, "A": 1.98},
    {"n": '3/4"',  "d": 1.905, "A": 2.85},
    {"n": '1"',    "d": 2.540, "A": 5.07},
]
DIVISORES   = {0: 20, 1: 24, 2: 28, 3: 10}
BORDE_TXT   = {0:"Simplemente apoyado", 1:"Un extremo continuo",
               2:"Ambos extremos continuos", 3:"En voladizo"}
TRAMO_NOMBRES = {1:["AB"], 2:["AB","BC"], 3:["AB","BC","CD"]}
APOYO_NOMBRES = {1:["A","B"], 2:["A","B","C"], 3:["A","B","C","D"]}

def elegir_varilla(As_req, s_max=40):
    for v in VARILLAS:
        s = (v["A"] / As_req) * 100
        if 7.5 <= s <= s_max:
            s_adopt = math.floor(s / 2.5) * 2.5
            s_adopt = min(max(s_adopt, 7.5), s_max)
            return v, round(s_adopt, 1), round((v["A"] / s_adopt) * 100, 2)
    v = VARILLAS[-1]
    s_adopt = min(math.floor((v["A"]/As_req)*100/2.5)*2.5, s_max)
    s_adopt = max(s_adopt, 7.5)
    return v, round(s_adopt, 1), round((v["A"] / s_adopt) * 100, 2)

def calc_As(Mu_tm, b, d, fc, fy):
    Mu = Mu_tm * 1e5          # tonf·m → kg·cm
    A  = (0.9 * fy**2) / (1.7 * fc * b)
    B  = 0.9 * fy * d
    disc = B**2 - 4*A*Mu
    return max((B - math.sqrt(disc)) / (2*A), 0) if disc >= 0 else None

def disenar(p):
    L1 = p["L1"]
    L2 = p["L2"]
    L3 = p.get("L3", L1)
    nt = p["ntramos"]
    fc  = p["fc"];  fy = p["fy"];  tb = p["tipo_borde"]
    rec = p["recub"]; dv = p["diam_v"]; b = 100.0
    CM_extra = p["acabados"] + p["tabiqueria"] + p.get("cm_extra", 0)
    CV_total = p["sc"] + p.get("cv_extra", 0)

    luces = {
    1:[L1],
    2:[L1,L2],
    3:[L1,L2,L3]
     }[nt]
    div   = DIVISORES[tb]

    # Predimensionamiento
    h_min_vals = [L / div for L in luces]
    h_min  = max(h_min_vals)
    h      = math.ceil(h_min / 0.05) * 0.05
    d_ef   = h*100 - rec - dv/2
    PP     = h * 2400
    CM     = PP + CM_extra
    CV     = CV_total
    Wu     = (1.4*CM + 1.7*CV) / 1000   # tonf/m

    # Momentos — método de coeficientes
    moms = []
    Ln   = max(luces)
    if nt == 1:
        cp = 8 if tb == 0 else 11
        moms.append(("AB", "+", "Tramo AB", Wu*L1**2/cp))
        if tb > 0:
            moms.append(("A",  "-", "Apoyo A",  Wu*L1**2/24))
            moms.append(("B",  "-", "Apoyo B",  Wu*L1**2/24))
    elif nt == 2:
        moms += [("AB","+","Tramo AB", Wu*L1**2/11),
                 ("BC","+","Tramo BC", Wu*L2**2/16),
                 ("A", "-","Apoyo A",  Wu*L1**2/24),
                 ("B", "-","Apoyo B",  Wu*Ln**2/10),
                 ("C", "-","Apoyo C",  Wu*L2**2/24)]
    else:
        moms += [("AB","+","Tramo AB", Wu*L1**2/11),
                 ("BC","+","Tramo BC", Wu*L2**2/16),
                 ("CD","+","Tramo CD", Wu*L1**2/11),
                 ("A", "-","Apoyo A",  Wu*L1**2/24),
                 ("B", "-","Apoyo B",  Wu*Ln**2/10),
                 ("C", "-","Apoyo C",  Wu*Ln**2/10),
                 ("D", "-","Apoyo D",  Wu*L1**2/24)]

    rho_min = 0.0018 if fy >= 4200 else 0.0020
    As_min  = rho_min * b * (h*100)
    s_max_t = min(3*h*100, 40)
    As_temp = rho_min * b * (h*100)

    resultados = []
    for key, signo, label, Mu in moms:
        As_c = calc_As(Mu, b, d_ef, fc, fy) or 0.0
        As_f = max(As_c, As_min)
        usa_min = As_f > As_c
        v, s, As_p = elegir_varilla(As_f)
        resultados.append(dict(key=key, signo=signo, label=label,
                               Mu=Mu, As_calc=As_c, As_min=As_min,
                               As_final=As_f, usa_min=usa_min,
                               varilla=v, s=s, As_prov=As_p))

    vt, st, Apt = elegir_varilla(As_temp, s_max=s_max_t)

    return dict(luces=luces, h=h, h_min=h_min, d=d_ef, PP=PP,
                CM=CM, CV=CV, Wu=Wu, rho_min=rho_min,
                As_min=As_min, As_temp=As_temp,
                v_temp=vt, s_temp=st, As_prov_temp=Apt,
                resultados=resultados, nt=nt, L1=L1, L2=L2, L3=L3,
                fc=fc, fy=fy)

