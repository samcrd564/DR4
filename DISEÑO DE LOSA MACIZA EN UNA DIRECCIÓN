    fig.text(0.5, 0.965, "DISEÑO DE LOSA MACIZA — UNA DIRECCIÓN  |  E.060",
             ha="center", va="top", fontsize=14, fontweight="bold", color="#1E293B")
    fig.text(0.5, 0.945,
             f"f'c={p['fc']} kg/cm²   fy={p['fy']} kg/cm²   "
