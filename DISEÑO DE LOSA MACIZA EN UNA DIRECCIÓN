    ax4.set_facecolor(PANEL)
    ax4.set_title("Metrado de cargas (kg/m²)", fontsize=9,
                  fontweight="bold", color="#1E293B", pad=6)

    lbs  = ["Peso propio", "Acabados", "Tabiquería", "Sobrecarga (CV)"]
