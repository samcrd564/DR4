    cols2 = [GRIS, "#64748B", "#94A3B8", AZUL]
    ax4.barh(lbs, vals, color=cols2, alpha=0.85, edgecolor="white", height=0.5)
    for i, v in enumerate(vals):
        ax4.text(v+5, i, f"{v:.0f}", va="center", fontsize=8, color="#1E293B")
    ax4.set_xlabel("kg/m²", fontsize=7.5)
    ax4.tick_params(labelsize=7.5)
    ax4.spines[["top","right"]].set_visible(False)

    wu_bar = ax4.axvline(r["Wu"]*1000, color=ROJO, lw=1.2, ls="--")
    ax4.text(r["Wu"]*1000+5, len(vals)-0.5,
             f"Wu={r['Wu']:.3f} t/m", color=ROJO, fontsize=7)

    # ── F: Panel resumen ──
    ax5 = fig.add_subplot(gs[2, 2])
    ax5.axis("off")
    ax5.set_facecolor(PANEL)
    ax5.set_title("Resumen ejecutivo", fontsize=9,
                  fontweight="bold", color="#1E293B", pad=6)

    pos_r2 = [r2 for r2 in res if r2["signo"]=="+"]
    neg_r2 = [r2 for r2 in res if r2["signo"]=="-"]
    lines = [
        ("f'c",  f"{p['fc']} kg/cm²"),
        ("fy",   f"{p['fy']} kg/cm²"),
        ("h",    f"{r['h']*100:.0f} cm"),
        ("d",    f"{r['d']:.1f} cm"),
        ("Wu",   f"{r['Wu']:.4f} tonf/m"),
        ("CM",   f"{r['CM']:.0f} kg/m²"),
