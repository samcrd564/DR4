    nt    = r["nt"]
    res   = r["resultados"]

    # ── A: Esquema de sección transversal ──
    ax0 = fig.add_subplot(gs[0, :2])
    ax0.set_facecolor(PANEL)
    ax0.set_xlim(0, sum(luces))
    ax0.set_ylim(-0.35, 0.35)
    ax0.set_title("Sección longitudinal — esquema de armado", fontsize=9,
                  fontweight="bold", color="#1E293B", pad=6)
    ax0.axis("off")

    x0 = 0
    apoyos_x = [0]
    for L in luces:
        apoyos_x.append(x0 + L)
        x0 += L
    total = sum(luces)

    # Cuerpo de la losa
    h_vis = 0.12
    ax0.add_patch(plt.Rectangle((0, -h_vis/2), total, h_vis,
                                 fc="#CBD5E1", ec=GRIS, lw=0.8, zorder=1))

    # Apoyos (vigas)
    for xv in apoyos_x:
        ax0.add_patch(plt.Rectangle((xv-0.08, -h_vis/2-0.06), 0.16, h_vis+0.06,
                                     fc="#94A3B8", ec="#64748B", lw=0.6, zorder=2))

    # Acero positivo (inferior)
    pos_res = [r2 for r2 in res if r2["signo"]=="+"]
    ax0.plot([apoyos_x[0], apoyos_x[-1]], [-h_vis/2+0.015, -h_vis/2+0.015],
             color=AZUL, lw=2.2, zorder=3)
    if pos_res:
        mid = total / 2
        v0  = pos_res[0]
        ax0.text(mid, -h_vis/2+0.035,
                 f"Ø {v0['varilla']['n']} @ {v0['s']:.0f} cm (+)",
                 ha="center", va="bottom", fontsize=7.5, color=AZUL, fontweight="bold")

    # Acero negativo (superior) — en zonas de apoyo
    neg_res = [r2 for r2 in res if r2["signo"]=="-"]
    long_zona = total / (nt*3)   # extensión visual L/3
    for i, xv in enumerate(apoyos_x):
        xL = max(0, xv - long_zona)
        xR = min(total, xv + long_zona)
        ax0.plot([xL, xR], [h_vis/2-0.015, h_vis/2-0.015],
                 color=ROJO, lw=2.2, zorder=3)
        if i < len(neg_res):
            nr = neg_res[i]
            ax0.text(xv, h_vis/2+0.02,
                     f"Ø {nr['varilla']['n']}@{nr['s']:.0f}cm",
                     ha="center", va="bottom", fontsize=6.5, color=ROJO)

    # Acero temp
    ax0.plot([apoyos_x[0], apoyos_x[-1]], [-h_vis/2+0.055, -h_vis/2+0.055],
             color=VERDE, lw=1.2, ls="--", zorder=3)
    ax0.text(total/2, -h_vis/2+0.065,
             f"Temp. Ø {r['v_temp']['n']} @ {r['s_temp']:.0f} cm ⊥",
             ha="center", va="bottom", fontsize=6.5, color=VERDE)

    # Cotas
    y_cota = -0.26
    ax0.annotate("", xy=(total, y_cota), xytext=(0, y_cota),
                 arrowprops=dict(arrowstyle="<->", color=GRIS, lw=0.8))
    ax0.text(total/2, y_cota-0.03, f"Longitud total = {total:.2f} m",
             ha="center", fontsize=7.5, color=GRIS)
    x0 = 0
    for i, L in enumerate(luces):
        ax0.annotate("", xy=(x0+L, y_cota+0.05), xytext=(x0, y_cota+0.05),
                     arrowprops=dict(arrowstyle="<->", color="#94A3B8", lw=0.7))
        ax0.text(x0+L/2, y_cota+0.07, f"Ln={L:.2f}m",
                 ha="center", fontsize=6.5, color=GRIS)
        x0 += L

    # Leyenda
    ax0.plot([], [], color=AZUL, lw=2, label="Acero (+) inferior")
    ax0.plot([], [], color=ROJO, lw=2, label="Acero (−) superior")
    ax0.plot([], [], color=VERDE, lw=1.5, ls="--", label="Acero temperatura")
    ax0.legend(loc="upper right", fontsize=7, framealpha=0.9, edgecolor=BORDE)

    # ── B: Diagrama de momentos ──
    ax1 = fig.add_subplot(gs[0, 2])
    ax1.set_facecolor(PANEL)
    ax1.set_title("Momentos flectores (tonf·m)", fontsize=9,
                  fontweight="bold", color="#1E293B", pad=6)

    etiquetas  = [r2["label"] for r2 in res]
    valores    = [r2["Mu"] for r2 in res]
    colores    = [AZUL if r2["signo"]=="+" else ROJO for r2 in res]
    bars = ax1.barh(etiquetas, valores, color=colores, alpha=0.85, edgecolor="white", height=0.55)
    for bar, val in zip(bars, valores):
        ax1.text(val + max(valores)*0.01, bar.get_y()+bar.get_height()/2,
                 f"{val:.3f}", va="center", fontsize=7.5, color="#1E293B")
    ax1.set_xlabel("Mu (tonf·m)", fontsize=7.5)
    ax1.tick_params(labelsize=7.5)
    ax1.spines[["top","right"]].set_visible(False)
    ax1.set_xlim(0, max(valores)*1.25)

    # ── C: Tabla de momentos y acero ──
    ax2 = fig.add_subplot(gs[1, :])
    ax2.axis("off")
    ax2.set_facecolor(PANEL)
    ax2.set_title("Resumen de diseño por sección", fontsize=9,
                  fontweight="bold", color="#1E293B", pad=6)

    cols = ["Sección", "Mu (t·m)", "As calc (cm²)", "As mín (cm²)",
            "As final (cm²)", "Varilla", "Ø área (cm²)", "S (cm)", "As prov (cm²)", "Nota"]
    data = []
    for r2 in res:
        data.append([
            r2["label"],
            f"{r2['Mu']:.4f}",
            f"{r2['As_calc']:.2f}",
            f"{r2['As_min']:.2f}",
            f"{r2['As_final']:.2f}",
            f"Ø {r2['varilla']['n']}",
            f"{r2['varilla']['A']:.2f}",
            f"{r2['s']:.1f}",
            f"{r2['As_prov']:.2f}",
            "ρ mín ▲" if r2["usa_min"] else "calc. ✓",
        ])

    tbl = ax2.table(cellText=data, colLabels=cols,
                    loc="center", cellLoc="center")
    tbl.auto_set_font_size(False)
    tbl.set_fontsize(7.5)
    tbl.scale(1, 1.55)

    for (row, col), cell in tbl.get_celld().items():
        cell.set_edgecolor(BORDE)
        if row == 0:
            cell.set_facecolor("#1E3A5F")
            cell.set_text_props(color="white", fontweight="bold")
        elif row % 2 == 0:
            cell.set_facecolor("#F1F5F9")
        else:
            cell.set_facecolor(PANEL)
        # Colorear nota
        if row > 0 and col == 9:
            txt = data[row-1][9]
            cell.set_facecolor("#FEF9C3" if "mín" in txt else "#DCFCE7")

    # ── D: Diagrama sección transversal ──
    ax3 = fig.add_subplot(gs[2, 0])
    ax3.set_facecolor(PANEL)
    ax3.set_title("Sección transversal (b=1m)", fontsize=9,
                  fontweight="bold", color="#1E293B", pad=6)
    ax3.set_aspect("equal")
    ax3.axis("off")

    bw, hh = 1.0, r["h"]
    ax3.add_patch(plt.Rectangle((0,0), bw, hh, fc="#CBD5E1", ec=GRIS, lw=1.2))
    # Recub
    rec_m = p["recub"]/100
    # Barras positivas (abajo)
    pos_r = [r2 for r2 in res if r2["signo"]=="+"]
    if pos_r:
        n_barras = min(6, int(1.0 / (pos_r[0]["s"]/100)) + 1)
        xs = [i * (pos_r[0]["s"]/100) for i in range(n_barras) if i*(pos_r[0]["s"]/100) <= bw]
        for x in xs:
            ax3.add_patch(plt.Circle((x, rec_m + p["diam_v"]/200),
                                      p["diam_v"]/200 * 1.8, fc=AZUL, ec="white", lw=0.5))
    # Barras negativas (arriba)
    neg_r = [r2 for r2 in res if r2["signo"]=="-"]
    if neg_r:
        n_barras = min(6, int(1.0 / (neg_r[0]["s"]/100)) + 1)
        xs = [i * (neg_r[0]["s"]/100) for i in range(n_barras) if i*(neg_r[0]["s"]/100) <= bw]
        for x in xs:
            ax3.add_patch(plt.Circle((x, hh - rec_m - p["diam_v"]/200),
                                      p["diam_v"]/200 * 1.8, fc=ROJO, ec="white", lw=0.5))
    # Cota h
    ax3.annotate("", xy=(-0.08, hh), xytext=(-0.08, 0),
                 arrowprops=dict(arrowstyle="<->", color=GRIS, lw=0.8))
    ax3.text(-0.12, hh/2, f"h={hh*100:.0f}cm\nd={r['d']:.1f}cm",
             ha="right", va="center", fontsize=7.5, color=GRIS)
    ax3.set_xlim(-0.2, 1.1)
    ax3.set_ylim(-0.05, hh+0.05)

