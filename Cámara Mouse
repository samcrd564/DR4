"""
Cámara Mouse v2 — Mejoras completas
======================================
Gestos disponibles:
  • Mover cursor   → índice extendido
  • Clic izquierdo → pellizco índice-pulgar (< UMBRAL_CLICK)
  • Clic derecho   → meñique extendido + resto doblado
  • Doble clic     → dos pellizcos rápidos (< DOBLE_CLICK_MS ms)
  • Scroll         → índice + medio extendidos, mover mano arriba/abajo
  • PAUSA          → puño cerrado (todos los dedos doblados)

Teclas:
  Q       → salir
  C       → iniciar calibración
  P       → guardar perfil actual
  R       → resetear calibración
"""

import cv2
import mediapipe as mp
from mediapipe.tasks import python as mp_python
from mediapipe.tasks.python import vision
import pyautogui
import numpy as np
from collections import deque
import urllib.request
import os
import json
import time
import threading

# ═══════════════════════════════════════════════════════════════
#  CONFIGURACIÓN POR DEFECTO  (se sobreescribe con perfil guardado)
# ═══════════════════════════════════════════════════════════════
DEFAULT_CONFIG = {
    "camara_id":        0,
    "suavizado":        7,
    "umbral_click":     35,
    "zona_muerta":      5,
    "cooldown_click_ms": 300,
    "doble_click_ms":   400,
    "scroll_velocidad": 8,
    "mano":             "Left",           # "Right" o "Left"
    "zona_x":           [0.1, 0.9],
    "zona_y":           [0.1, 0.9],
}

CONFIG_PATH = "perfil_mouse.json"
MODEL_PATH  = "hand_landmarker.task"
MODEL_URL   = ("https://storage.googleapis.com/mediapipe-models/"
               "hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task")

# ═══════════════════════════════════════════════════════════════
#  FILTRO KALMAN  (suavizado predictivo, reemplaza promedio simple)
# ═══════════════════════════════════════════════════════════════
class KalmanCursor:
    def __init__(self):
        self.kf_x = self._make_kf()
        self.kf_y = self._make_kf()

    @staticmethod
    def _make_kf():
        kf = cv2.KalmanFilter(4, 2)
        kf.measurementMatrix  = np.array([[1,0,0,0],[0,1,0,0]], np.float32)
        kf.transitionMatrix   = np.array([[1,0,1,0],[0,1,0,1],
                                           [0,0,1,0],[0,0,0,1]], np.float32)
        kf.processNoiseCov    = np.eye(4, dtype=np.float32) * 1e-2
        kf.measurementNoiseCov= np.eye(2, dtype=np.float32) * 1e-1
        kf.errorCovPost       = np.eye(4, dtype=np.float32)
        return kf

    def update(self, x, y):
        mx = np.array([[np.float32(x)], [np.float32(0)]])
        my = np.array([[np.float32(y)], [np.float32(0)]])
        self.kf_x.correct(mx)
        self.kf_y.correct(my)
        px = int(self.kf_x.predict()[0][0])
        py = int(self.kf_y.predict()[0][0])
        return px, py

# ═══════════════════════════════════════════════════════════════
#  CALIBRACIÓN
# ═══════════════════════════════════════════════════════════════
class Calibrador:
    # (nombre, flecha, posición destino en px para la cruz guía)
    PUNTOS = [
        ("esquina SUPERIOR-IZQUIERDA", "arriba-izq",  (60,  60)),
        ("esquina SUPERIOR-DERECHA",   "arriba-der",  (580, 60)),
        ("esquina INFERIOR-DERECHA",   "abajo-der",   (580, 420)),
        ("esquina INFERIOR-IZQUIERDA", "abajo-izq",   (60,  420)),
    ]
    ESPERA = 2.5   # segundos quieto para capturar automáticamente

    def __init__(self):
        self.activo    = False
        self.paso      = 0
        self.capturas  = []
        self.resultado = None
        self._t_inicio = None

    def iniciar(self):
        self.activo    = True
        self.paso      = 0
        self.capturas  = []
        self.resultado = None
        self._t_inicio = None

    def cancelar(self):
        self.activo = False

    def tick(self, lx, ly, ancho, alto):
        """
        Llama cada frame. Retorna:
          'esperando'  -> mano fuera del area
          0..1 (float) -> progreso cuenta regresiva
          'capturado'  -> punto registrado
          'completo'   -> calibracion terminada
        """
        if not self.activo:
            return 'esperando'
        _, _, (tx, ty) = self.PUNTOS[self.paso]
        tol_x = ancho * 0.18
        tol_y = alto  * 0.18
        px    = lx * ancho
        py    = ly * alto
        if abs(px - tx) < tol_x and abs(py - ty) < tol_y:
            if self._t_inicio is None:
                self._t_inicio = time.time()
            progreso = (time.time() - self._t_inicio) / self.ESPERA
            if progreso >= 1.0:
                self.capturas.append((lx, ly))
                self.paso     += 1
                self._t_inicio = None
                if self.paso >= len(self.PUNTOS):
                    xs = [p[0] for p in self.capturas]
                    ys = [p[1] for p in self.capturas]
                    self.resultado = (min(xs), max(xs), min(ys), max(ys))
                    self.activo    = False
                    return 'completo'
                return 'capturado'
            return min(progreso, 1.0)
        else:
            self._t_inicio = None
            return 'esperando'

    @property
    def nombre_actual(self):
        return self.PUNTOS[self.paso][0] if self.activo else ""

    @property
    def destino_actual(self):
        return self.PUNTOS[self.paso][2] if self.activo else (0, 0)

# ═══════════════════════════════════════════════════════════════
#  GESTOS  (detección basada en landmarks)
# ═══════════════════════════════════════════════════════════════
def dedo_extendido(lm, punta, base):
    """True si la punta está claramente más lejos de la muñeca que la base."""
    muneca = lm[0]
    dp = (lm[punta].x - muneca.x)**2 + (lm[punta].y - muneca.y)**2
    db = (lm[base].x  - muneca.x)**2 + (lm[base].y  - muneca.y)**2
    return dp > db * 1.2

def puno_cerrado(lm):
    """Puno real: TODAS las puntas muy cerca de la palma."""
    muneca = lm[0]
    centro = lm[9]
    tam = np.hypot(muneca.x - centro.x, muneca.y - centro.y)
    if tam < 0.01:
        return False
    # Umbral muy estricto: 0.40 en lugar de 0.60
    for p in [8, 12, 16, 20]:
        dist = np.hypot(lm[p].x - muneca.x, lm[p].y - muneca.y)
        if dist > tam * 0.40:
            return False
    return True

def detectar_gesto(lm):
    """
    Retorna uno de: 'mover', 'click_izq', 'click_der', 'scroll', 'pausa'
    """
    indice  = dedo_extendido(lm,  8,  6)
    medio   = dedo_extendido(lm, 12, 10)
    anular  = dedo_extendido(lm, 16, 14)
    menique = dedo_extendido(lm, 20, 18)

    ix, iy = lm[8].x, lm[8].y
    tx, ty = lm[4].x, lm[4].y
    dist   = np.hypot(ix - tx, iy - ty)

    pellizco = dist < 0.07

    # Puno cerrado real -> pausa
    if puno_cerrado(lm):
        return "pausa"

    # Mover cursor -> indice + medio levantados
    if indice and medio and not anular and not menique:
        return "mover"

    # Pellizco -> clic izquierdo (solo indice)
    if indice and not medio and pellizco:
        return "click_izq"

    # Menique solo -> clic derecho
    if menique and not indice and not medio and not anular:
        return "click_der"

    # Indice + medio + anular -> scroll
    if indice and medio and anular and not menique:
        return "scroll"

    # Todos los dedos abiertos -> doble clic
    if indice and medio and anular and menique:
        return "doble_clic"

    return "quieto"

# ═══════════════════════════════════════════════════════════════
#  HELPERS DE PERFIL
# ═══════════════════════════════════════════════════════════════
def cargar_config():
    if os.path.exists(CONFIG_PATH):
        try:
            with open(CONFIG_PATH) as f:
                datos = json.load(f)
            cfg = DEFAULT_CONFIG.copy()
            cfg.update(datos)
            print(f"Perfil cargado desde {CONFIG_PATH}")
            return cfg
        except Exception as e:
            print(f"Error leyendo perfil: {e}")
    return DEFAULT_CONFIG.copy()

def guardar_config(cfg):
    try:
        with open(CONFIG_PATH, "w") as f:
            json.dump(cfg, f, indent=2)
        print(f"Perfil guardado en {CONFIG_PATH}")
    except Exception as e:
        print(f"Error guardando perfil: {e}")

# ═══════════════════════════════════════════════════════════════
#  MAIN
# ═══════════════════════════════════════════════════════════════
def main():
    cfg = cargar_config()

    pyautogui.FAILSAFE = True
    pantalla_w, pantalla_h = pyautogui.size()

    # ── Descargar modelo si no existe ──────────────────────────
    if not os.path.exists(MODEL_PATH):
        print("Descargando modelo de MediaPipe (~8 MB)...")
        urllib.request.urlretrieve(MODEL_URL, MODEL_PATH)
        print("Modelo descargado.")

    # ── Estado compartido ──────────────────────────────────────
    landmarks_glob = None
    landmarks_lock = threading.Lock()
    handedness_glob = None

    def on_result(result, output_image, timestamp_ms):
        nonlocal landmarks_glob, handedness_glob
        with landmarks_lock:
            if result.hand_landmarks:
                landmarks_glob  = result.hand_landmarks[0]
                handedness_glob = (result.handedness[0][0].display_name
                                   if result.handedness else "Unknown")
            else:
                landmarks_glob  = None
                handedness_glob = None

    # ── Detector MediaPipe ─────────────────────────────────────
    base_options = mp_python.BaseOptions(model_asset_path=MODEL_PATH)
    options = vision.HandLandmarkerOptions(
        base_options=base_options,
        running_mode=vision.RunningMode.LIVE_STREAM,
        num_hands=1,
        min_hand_detection_confidence=0.7,
        min_hand_presence_confidence=0.7,
        min_tracking_confidence=0.7,
        result_callback=on_result,
    )
    detector = vision.HandLandmarker.create_from_options(options)

    cap = cv2.VideoCapture(cfg["camara_id"])
    cap.set(cv2.CAP_PROP_FRAME_WIDTH,  640)
    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

    # ── Objetos auxiliares ─────────────────────────────────────
    kalman      = KalmanCursor()
    calibrador  = Calibrador()

    # Estados de clic / scroll
    ultimo_click_t  = 0
    ultimo_pellizco = False
    penultimo_click = 0      # para doble clic
    scroll_y_prev   = None
    gesto_prev      = "mover"

    # Overlay de notificación
    notif_texto = ""
    notif_t     = 0
    NOTIF_DUR   = 2.0         # segundos

    timestamp = 0

    print("\n=== Cámara Mouse v2 ===")
    print("  Indice + medio        → mover cursor")
    print("  Solo indice + pellizco→ clic izquierdo")
    print("  Solo menique          → clic derecho")
    print("  Indice+medio+anular   → scroll")
    print("  Todos los dedos       → doble clic")
    print("  Puno cerrado          → PAUSA")
    print("  C               → calibrar zona")
    print("  P               → guardar perfil")
    print("  Q               → salir\n")

    def notif(texto):
        nonlocal notif_texto, notif_t
        notif_texto = texto
        notif_t     = time.time()

    while True:
        ok, frame = cap.read()
        if not ok:
            print("Error leyendo la cámara.")
            break

        frame = cv2.flip(frame, 1)
        alto, ancho = frame.shape[:2]
        ahora = time.time()

        # ── Enviar a MediaPipe ─────────────────────────────────
        rgb      = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
        mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)
        detector.detect_async(mp_image, timestamp)
        timestamp += 1

        # ── Leer landmarks (hilo seguro) ───────────────────────
        with landmarks_lock:
            lm        = landmarks_glob
            handedness= handedness_glob

        # ── Modo calibración ───────────────────────────────────
        if calibrador.activo:
            cv2.rectangle(frame, (0, 0), (ancho, alto), (0, 200, 255), 3)

            # Cruz guía en la esquina destino
            tx, ty = calibrador.destino_actual
            cruz = 22
            cv2.line(frame, (tx-cruz, ty), (tx+cruz, ty), (0,200,255), 2)
            cv2.line(frame, (tx, ty-cruz), (tx, ty+cruz), (0,200,255), 2)
            cv2.circle(frame, (tx, ty), 6, (0,200,255), -1)

            # Instrucciones
            cv2.putText(frame, f"Paso {calibrador.paso+1}/4  -  ESC para cancelar",
                        (10, 28), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0,200,255), 2)
            cv2.putText(frame, f"Mueve el INDICE a la {calibrador.nombre_actual}",
                        (10, 56), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (255,255,255), 2)
            cv2.putText(frame, "(mantente quieto hasta que se llene el circulo)",
                        (10, 80), cv2.FONT_HERSHEY_SIMPLEX, 0.45, (180,180,180), 1)

            if lm:
                ix = int(lm[8].x * ancho)
                iy = int(lm[8].y * alto)

                estado = calibrador.tick(lm[8].x, lm[8].y, ancho, alto)

                if isinstance(estado, float):
                    # Arco de progreso alrededor del índice
                    angulo = int(360 * estado)
                    cv2.ellipse(frame, (ix, iy), (20, 20), -90, 0, angulo,
                                (0, 255, 100), 3)
                    cv2.circle(frame, (ix, iy), 10, (0, 200, 255), -1)
                    seg = max(1, int(calibrador.ESPERA - calibrador.ESPERA * estado) + 1)
                    cv2.putText(frame, str(seg), (ix+14, iy-14),
                                cv2.FONT_HERSHEY_SIMPLEX, 0.6, (0,255,100), 2)
                elif estado == 'capturado':
                    notif(f"Punto {calibrador.paso}/4 guardado!")
                elif estado == 'completo':
                    x0, x1, y0, y1 = calibrador.resultado
                    cfg["zona_x"] = [round(x0, 3), round(x1, 3)]
                    cfg["zona_y"] = [round(y0, 3), round(y1, 3)]
                    print(f"Calibracion completa: X={cfg['zona_x']}  Y={cfg['zona_y']}")
                    notif("Calibracion completa!")
                else:
                    # esperando — mostrar solo punto índice
                    cv2.circle(frame, (ix, iy), 10, (0, 200, 255), -1)
            else:
                cv2.putText(frame, "No se detecta mano...", (10, 110),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.55, (100,100,255), 2)
        else:
            # ── Procesamiento normal ───────────────────────────
            if lm:
                # Verificar que la mano sea la correcta
                # Aceptar cualquier mano sin restriccion
                ix_px = int(lm[8].x * ancho)
                iy_px = int(lm[8].y * alto)

                gesto = detectar_gesto(lm)

                if gesto == "pausa":
                    # ── PAUSA ──────────────────────────────────
                    cv2.putText(frame, "PAUSA (puno cerrado)", (10, 30),
                                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (200,200,200), 2)
                    scroll_y_prev = None
                    ultimo_pellizco = False

                elif gesto == "scroll":
                    # ── SCROLL ─────────────────────────────────
                    if scroll_y_prev is not None:
                        dy = lm[8].y - scroll_y_prev
                        if abs(dy) > 0.005:
                            pasos = int(dy * cfg["scroll_velocidad"] * 100)
                            pyautogui.scroll(-pasos)
                    scroll_y_prev = lm[8].y
                    cv2.putText(frame, "SCROLL", (10, 30),
                                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255,200,0), 2)
                    cv2.circle(frame, (ix_px, iy_px), 10, (255,200,0), -1)

                elif gesto == "quieto":
                    cv2.putText(frame, "quieto", (10, 30),
                                cv2.FONT_HERSHEY_SIMPLEX, 0.7, (150,150,150), 2)
                    scroll_y_prev = None

                else:
                    scroll_y_prev = None
                    # ── Kalman → posición del cursor ───────────
                    MARGEN = 20
                    cx = np.interp(lm[8].x, cfg["zona_x"], [MARGEN, pantalla_w - MARGEN])
                    cy = np.interp(lm[8].y, cfg["zona_y"], [MARGEN, pantalla_h - MARGEN])
                    kx, ky = kalman.update(cx, cy)
                    kx = max(MARGEN, min(pantalla_w - MARGEN, kx))
                    ky = max(MARGEN, min(pantalla_h - MARGEN, ky))

                    pos = pyautogui.position()
                    if (abs(kx - pos.x) + abs(ky - pos.y)) > cfg["zona_muerta"]:
                        pyautogui.moveTo(kx, ky, duration=0)

                    # ── Gestos de clic ─────────────────────────
                    if gesto == "click_der" and gesto_prev != "click_der":
                        pyautogui.rightClick()
                        notif("Clic derecho")

                    elif gesto == "doble_clic" and gesto_prev != "doble_clic":
                        ahora2 = time.time()
                        if (ahora2 - ultimo_click_t) * 1000 > cfg["cooldown_click_ms"]:
                            pyautogui.doubleClick()
                            ultimo_click_t = ahora2
                            notif("Doble clic!")

                    elif gesto == "click_izq":
                        if not ultimo_pellizco:
                            cooldown_ok = (ahora - ultimo_click_t) * 1000 > cfg["cooldown_click_ms"]
                            if cooldown_ok:
                                if (ahora - penultimo_click) * 1000 < cfg["doble_click_ms"]:
                                    pyautogui.doubleClick()
                                    notif("Doble clic")
                                    penultimo_click = 0
                                else:
                                    pyautogui.click()
                                    penultimo_click = ultimo_click_t
                                ultimo_click_t  = ahora

                    ultimo_pellizco = (gesto == "click_izq")

                    # ── Dibujo ─────────────────────────────────
                    tx_px = int(lm[4].x * ancho)
                    ty_px = int(lm[4].y * alto)
                    dist_px = int(np.hypot(ix_px - tx_px, iy_px - ty_px))
                    color = (0, 0, 255) if gesto == "click_izq" else (0, 255, 100)
                    cv2.circle(frame, (ix_px, iy_px), 10, color, -1)
                    cv2.circle(frame, (tx_px, ty_px),  8, (255,200,0), -1)
                    cv2.line  (frame, (ix_px, iy_px), (tx_px, ty_px), color, 2)

                    label = f"CLICK ({dist_px}px)" if gesto == "click_izq" else f"dist: {dist_px}px"
                    cv2.putText(frame, label, (10, 30),
                                cv2.FONT_HERSHEY_SIMPLEX, 0.7, color, 2)
                    cv2.putText(frame, f"gesto: {gesto}", (10, alto - 40),
                                cv2.FONT_HERSHEY_SIMPLEX, 0.55, (255, 255, 0), 2)

                gesto_prev = gesto
            else:
                gesto_prev = "mover"
                cv2.putText(frame, "Sin mano detectada", (10, 30),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.7, (100,100,255), 2)

        # ── HUD: barra de confianza (landmarks visibles) ───────
        if lm:
            conf = min(1.0, len([l for l in lm if hasattr(l,'visibility') and l.visibility is not None and l.visibility > 0.5]) / 21.0 + 0.7)
            bw   = int(120 * conf)
            cv2.rectangle(frame, (ancho-135, 45), (ancho-15, 62), (50,50,50), -1)
            cv2.rectangle(frame, (ancho-135, 45), (ancho-135+bw, 62), (0,220,120), -1)
            cv2.putText  (frame, "conf", (ancho-135, 43),
                          cv2.FONT_HERSHEY_SIMPLEX, 0.4, (180,180,180), 1)

        # ── Indicador de mano detectada ────────────────────────
        if handedness:
            etiq = f"Mano: {handedness}"
            cv2.putText(frame, etiq, (10, alto - 15),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.5, (180,180,180), 1)

        # ── Notificación flotante ──────────────────────────────
        if notif_texto and (ahora - notif_t) < NOTIF_DUR:
            alpha = 1.0 - (ahora - notif_t) / NOTIF_DUR
            color_n = (int(255*alpha), int(255*alpha), 0)
            cv2.putText(frame, notif_texto, (ancho//2 - 80, alto//2),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.8, color_n, 2)

        # ── Leyenda ────────────────────────────────────────────
        cv2.putText(frame, "Q=salir  C=calibrar  P=perfil",
                    (ancho - 260, 30),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.45, (200,200,200), 1)

        cv2.imshow("Camara Mouse v2", frame)

        # ── Teclado ────────────────────────────────────────────
        key = cv2.waitKey(1) & 0xFF

        if key == ord('q'):
            break

        elif key == ord('c'):
            calibrador.iniciar()
            print("Calibración iniciada. Sigue las instrucciones en pantalla.")

        elif key == ord('p'):
            guardar_config(cfg)
            notif("Perfil guardado")

        elif key == ord('r'):
            cfg["zona_x"] = DEFAULT_CONFIG["zona_x"]
            cfg["zona_y"] = DEFAULT_CONFIG["zona_y"]
            notif("Calibracion reseteada")
            print("Calibración reseteada a valores por defecto.")

        elif key == 27:   # ESC
            if calibrador.activo:
                calibrador.cancelar()
                notif("Calibracion cancelada")
                print("Calibracion cancelada.")

    # ── Limpieza ───────────────────────────────────────────────
    detector.close()
    cap.release()
    cv2.destroyAllWindows()
    print("Programa terminado.")


if __name__ == "__main__":
    main()
